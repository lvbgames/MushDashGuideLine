{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvb-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "10 15 * * *"
    ]
  },
  "vars": {
    "ANALYTICS_ENV": "production",
    "ALLOWED_ORIGIN": "https://lvb.kr"
  },
  "secrets": {
    "required": [
      "ANALYTICS_HASH_SECRET",
      "ANALYTICS_ADMIN_USER",
      "ANALYTICS_ADMIN_PASSWORD_HASH",
      "ANALYTICS_ADMIN_PASSWORD_SALT"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lvb-analytics",
      "database_id": "a1de719b-17d4-47cb-be41-562c54621657",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "HIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
