---
import type { Game } from '../../types/game';
import type { Translation } from '../../i18n/translations/en';
import Container from '../ui/Container.astro';
import GameMedia from '../game/GameMedia.astro';
import GameStatusBadge from '../game/GameStatusBadge.astro';
import GameStoreButtons from '../game/GameStoreButtons.astro';
import ButtonLink from '../ui/ButtonLink.astro';

interface Props {
  game: Game;
  translation: Translation;
  detailPath: string;
}

const { game, translation, detailPath } = Astro.props;
const statusLabels = {
  upcoming: translation.common.coming2027,
  'early-access': translation.common.earlyAccess,
  available: translation.common.available
};
const image = game.screenshots[0] ?? game.heroImage;
---

<section class="mushdash-section page-section" id="mushdash" aria-labelledby="mushdash-title">
  <Container className="mushdash-section__inner">
    <GameMedia image={image} alt={game.title} fallbackText={translation.common.mediaUnavailable} className="mushdash-section__media" />
    <div class="mushdash-section__content">
      <p class="eyebrow">{translation.home.dashEyebrow}</p>
      <GameStatusBadge game={game} labels={statusLabels} />
      <p class="mushdash-section__name">{game.title}</p>
      <h2 id="mushdash-title">{translation.home.dashTitle}</h2>
      <p>{translation.home.dashDescription}</p>
      <div class="mushdash-section__actions">
        <GameStoreButtons game={game} labels={translation.common} />
        <ButtonLink href={detailPath} variant="quiet">{translation.home.dashDetailCta}</ButtonLink>
      </div>
    </div>
  </Container>
</section>
