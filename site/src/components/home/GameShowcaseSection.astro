---
import type { Game, GameImage } from '../../types/game';
import type { Translation } from '../../i18n/translations/en';
import { getHomeImageSrcSet } from '../../data/homeMedia';
import ButtonLink from '../ui/ButtonLink.astro';
import Container from '../ui/Container.astro';
import HeadlineText from '../ui/HeadlineText.astro';
import GameStatusBadge from '../game/GameStatusBadge.astro';
import GameStoreButtons from '../game/GameStoreButtons.astro';

interface Props {
  game: Game;
  images: readonly GameImage[];
  translation: Translation;
  detailPath: string;
}

const { game, images, translation, detailPath } = Astro.props;
const isMushHero = game.slug === 'mushhero';
const headingId = `home-${game.slug}-title`;
const statusLabels = {
  upcoming: translation.common.coming2027,
  'early-access': translation.common.earlyAccess,
  available: translation.common.available
};
const eyebrow = isMushHero ? translation.home.featuredEyebrow : translation.home.dashEyebrow;
const title = isMushHero ? translation.home.featuredTitle : translation.home.dashTitle;
const titleLines = isMushHero ? translation.home.featuredTitleLines : undefined;
const description = isMushHero ? translation.home.featuredDescription : translation.home.dashDescription;
const detailLabel = isMushHero ? translation.home.heroSecondary : translation.home.dashDetailCta;
const imageAlts = isMushHero ? translation.mushHero.screenshotAlts : translation.mushDash.screenshotAlts;
const galleryLabel = isMushHero ? translation.mushHero.galleryTitle : translation.mushDash.galleryTitle;

if (images.length !== 2) {
  throw new Error(`Home ${game.title} showcase requires exactly two images.`);
}
---

<section
  class:list={['home-game-showcase', `home-game-showcase--${game.slug}`, 'page-section']}
  id={isMushHero ? 'mushhero-overview' : 'mushdash'}
  aria-labelledby={headingId}
  data-home-game-showcase={game.slug}
  data-motion-direction={isMushHero ? 'left' : 'right'}
>
  <Container className="home-game-showcase__inner">
    <div class="home-game-showcase__content" data-motion-item>
      <div class="home-game-showcase__meta">
        <p class="eyebrow">{eyebrow}</p>
        <GameStatusBadge game={game} labels={statusLabels} />
      </div>
      <p class="home-game-showcase__name">{game.title}</p>
      <h2 id={headingId}>
        <HeadlineText text={title} lines={titleLines} />
      </h2>
      <p class="home-game-showcase__description">{description}</p>
      <div class="home-game-showcase__actions">
        <GameStoreButtons game={game} labels={translation.common} steamPrimary={isMushHero} />
        <ButtonLink href={detailPath} variant="quiet">{detailLabel}</ButtonLink>
      </div>
    </div>

    <div class="home-game-showcase__gallery" role="group" aria-label={galleryLabel} data-motion-item>
      {images.map((image, index) => {
        const srcset = getHomeImageSrcSet(image.src);
        return (
          <figure data-home-game-image>
            <img
              src={image.src}
              srcset={srcset}
              sizes={srcset ? '(min-width: 64rem) 58vw, 100vw' : undefined}
              width={image.width}
              height={image.height}
              alt={imageAlts[index] ?? game.title}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </figure>
        );
      })}
    </div>
  </Container>
</section>
