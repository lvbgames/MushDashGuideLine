---
import type { Game } from '../../types/game';
import type { Locale } from '../../i18n/config';
import type { Translation } from '../../i18n/translations/en';
import { getHomeImageSrcSet } from '../../data/homeMedia';
import ButtonLink from '../ui/ButtonLink.astro';
import Container from '../ui/Container.astro';
import GameStatusBadge from '../game/GameStatusBadge.astro';
import GameStoreButtons from '../game/GameStoreButtons.astro';
import HeadlineText from '../ui/HeadlineText.astro';

interface Props {
  mushHero: Game;
  mushDash: Game;
  locale: Locale;
  translation: Translation;
  mushHeroPath: string;
  mushDashPath: string;
}

const { mushHero, mushDash, locale, translation, mushHeroPath, mushDashPath } = Astro.props;
const statusLabels = {
  upcoming: translation.common.coming2027,
  'early-access': translation.common.earlyAccess,
  available: translation.common.available
};
const heroGames = [
  {
    game: mushHero,
    genre: translation.home.featuredEyebrow,
    headline: translation.home.featuredTitle,
    headlineLines: translation.home.featuredTitleLines,
    description: translation.home.heroDescription,
    detailLabel: translation.home.heroSecondary,
    detailPath: mushHeroPath
  },
  {
    game: mushDash,
    genre: mushDash.detailTags[locale]?.[0] ?? mushDash.genres[0],
    headline: translation.home.dashTitle,
    headlineLines: undefined,
    description: translation.home.dashDescription,
    detailLabel: translation.home.dashDetailCta,
    detailPath: mushDashPath
  }
] as const;

heroGames.forEach(({ game }) => {
  if (game.screenshots.length < 2) throw new Error(`Home Hero requires two verified ${game.title} images.`);
});

const heroSlides = heroGames.flatMap(({ game }, gameIndex) => game.screenshots.slice(0, 2).map((image, imageIndex) => ({
  game,
  gameIndex,
  image,
  imageIndex
})));
---

<section
  class="home-hero"
  aria-labelledby="home-hero-title"
  data-home-hero
  data-current-game="mushhero"
  data-current-slide="0"
  data-hero-autoplay="true"
  data-play-label={translation.home.heroMedia.playSlideshow}
>
  <div class="home-hero__backgrounds" aria-hidden="true">
    {heroSlides.map(({ game, image, gameIndex, imageIndex }, slideIndex) => {
      const srcset = getHomeImageSrcSet(image.src);
      const isInitialImage = slideIndex === 0;
      return (
        <div
          class:list={[
            'home-hero__background',
            `home-hero__background--${game.slug}-${imageIndex + 1}`,
            { 'is-active': isInitialImage }
          ]}
          data-hero-background-slide
          data-slide-index={slideIndex}
          data-slide-game={game.slug}
          data-game-index={gameIndex}
        >
          <img
            src={isInitialImage ? image.src : undefined}
            srcset={isInitialImage ? srcset : undefined}
            sizes="100vw"
            data-src={!isInitialImage ? image.src : undefined}
            data-srcset={!isInitialImage ? srcset : undefined}
            width={image.width}
            height={image.height}
            alt=""
            loading={isInitialImage ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={isInitialImage ? 'high' : 'low'}
          />
        </div>
      );
    })}
  </div>

  <Container className="home-hero__inner">
    <h1 id="home-hero-title" class="screen-reader">{translation.home.gamesTitle}: MushHero, MushDash</h1>

    <div class="home-hero__content-stage">
      {heroGames.map(({ game, genre, headline, headlineLines, description, detailLabel, detailPath }, gameIndex) => (
        <div
          class:list={['home-hero__content-panel', `home-hero__content-panel--${game.slug}`, { 'is-active': gameIndex === 0 }]}
          aria-hidden={gameIndex === 0 ? 'false' : 'true'}
          inert={gameIndex === 0 ? undefined : true}
          data-hero-content-panel
          data-content-game={game.slug}
          data-game-index={gameIndex}
        >
          <div class="home-hero__meta">
            <p class="eyebrow">{genre}</p>
            <GameStatusBadge game={game} labels={statusLabels} />
          </div>
          <p class="home-hero__game-title">{game.title}</p>
          <h2><HeadlineText text={headline} lines={headlineLines} /></h2>
          <p class="home-hero__description">{description}</p>
          <div class="home-hero__actions">
            <GameStoreButtons game={game} labels={translation.common} steamPrimary />
            <ButtonLink href={detailPath} variant="quiet">{detailLabel}</ButtonLink>
          </div>
        </div>
      ))}
    </div>

    <div class="home-hero__controls">
      <div class="home-hero__dots" role="group" aria-label={translation.home.gamesTitle}>
        {heroSlides.map(({ game, imageIndex }, slideIndex) => (
          <button
            type="button"
            data-hero-dot
            data-slide-index={slideIndex}
            aria-label={`${translation.home.heroMedia.showImage} ${slideIndex + 1}: ${game.title} ${imageIndex + 1}`}
            aria-current={slideIndex === 0 ? 'true' : undefined}
          ><span aria-hidden="true"></span></button>
        ))}
      </div>
      <button
        type="button"
        class="home-hero__playback"
        data-hero-playback
        aria-label={translation.home.heroMedia.pauseSlideshow}
        aria-pressed="false"
        title={translation.home.heroMedia.pauseSlideshow}
      >
        <span aria-hidden="true" data-hero-playback-icon>Ⅱ</span>
      </button>
    </div>
    <span class="screen-reader" aria-live="polite" data-hero-slide-live></span>
  </Container>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-hero]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-background-slide]'));
    const contentPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-content-panel]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const playback = root.querySelector<HTMLButtonElement>('[data-hero-playback]');
    const playbackIcon = root.querySelector<HTMLElement>('[data-hero-playback-icon]');
    const slideLive = root.querySelector<HTMLElement>('[data-hero-slide-live]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const autoPlayDelay = 6500;
    const preloadLeadTime = 1800;
    const pauseLabel = playback?.getAttribute('aria-label') ?? '';
    const playLabel = root.dataset.playLabel ?? '';
    let currentSlide = 0;
    let currentGame = 0;
    let autoPlayTimer: number | undefined;
    let preloadTimer: number | undefined;
    let isPointerPaused = false;
    let isFocusPaused = false;
    let isUserPaused = false;

    if (slides.length !== 4 || contentPanels.length !== 2 || dots.length !== 4 || !playback || !playbackIcon) return;

    const loadImage = (slide: HTMLElement | undefined) => {
      const image = slide?.querySelector<HTMLImageElement>('img');
      if (!image) return;
      if (!image.src && image.dataset.src) image.src = image.dataset.src;
      if (!image.srcset && image.dataset.srcset) image.srcset = image.dataset.srcset;
    };

    const stopAutoPlay = () => {
      if (autoPlayTimer !== undefined) window.clearTimeout(autoPlayTimer);
      if (preloadTimer !== undefined) window.clearTimeout(preloadTimer);
      autoPlayTimer = undefined;
      preloadTimer = undefined;
    };

    const canAutoPlay = () => (
      !isPointerPaused
      && !isFocusPaused
      && !isUserPaused
      && !reducedMotion.matches
      && document.visibilityState === 'visible'
    );

    const scheduleAutoPlay = () => {
      stopAutoPlay();
      if (!canAutoPlay()) return;
      const nextSlide = (currentSlide + 1) % slides.length;
      preloadTimer = window.setTimeout(() => loadImage(slides[nextSlide]), autoPlayDelay - preloadLeadTime);
      autoPlayTimer = window.setTimeout(() => {
        showSlide(nextSlide, false, false);
        scheduleAutoPlay();
      }, autoPlayDelay);
    };

    const showGameContent = (gameIndex: number) => {
      if (gameIndex === currentGame) return;
      currentGame = gameIndex;
      contentPanels.forEach((panel, index) => {
        const isActive = index === currentGame;
        panel.classList.toggle('is-active', isActive);
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        panel.toggleAttribute('inert', !isActive);
      });
      root.dataset.currentGame = slides[currentSlide]?.dataset.slideGame ?? '';
    };

    const showSlide = (nextIndex: number, announce = true, restartAutoPlay = true) => {
      currentSlide = (nextIndex + slides.length) % slides.length;
      loadImage(slides[currentSlide]);
      slides.forEach((slide, index) => slide.classList.toggle('is-active', index === currentSlide));
      dots.forEach((dot, index) => {
        if (index === currentSlide) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      root.dataset.currentSlide = String(currentSlide);
      showGameContent(Number(slides[currentSlide]?.dataset.gameIndex ?? 0));
      if (announce && slideLive) {
        const gameTitle = contentPanels[currentGame]?.dataset.contentGame === 'mushdash' ? 'MushDash' : 'MushHero';
        slideLive.textContent = `${gameTitle}, ${currentSlide + 1} / ${slides.length}`;
      }
      if (restartAutoPlay) scheduleAutoPlay();
    };

    const updatePlayback = () => {
      const label = isUserPaused ? playLabel : pauseLabel;
      playback.setAttribute('aria-label', label);
      playback.setAttribute('title', label);
      playback.setAttribute('aria-pressed', isUserPaused ? 'true' : 'false');
      playbackIcon.textContent = isUserPaused ? '▶' : 'Ⅱ';
    };

    dots.forEach((dot) => dot.addEventListener('click', () => {
      showSlide(Number(dot.dataset.slideIndex ?? 0));
    }));

    playback.addEventListener('click', () => {
      isUserPaused = !isUserPaused;
      updatePlayback();
      if (isUserPaused) stopAutoPlay();
      else scheduleAutoPlay();
    });

    root.addEventListener('pointerenter', () => {
      isPointerPaused = true;
      stopAutoPlay();
    });
    root.addEventListener('pointerleave', () => {
      isPointerPaused = false;
      scheduleAutoPlay();
    });

    const updateFocusPause = () => {
      const activeElement = document.activeElement;
      isFocusPaused = activeElement instanceof HTMLElement && root.contains(activeElement) && activeElement !== playback;
      if (isFocusPaused) stopAutoPlay();
      else scheduleAutoPlay();
    };
    root.addEventListener('focusin', updateFocusPause);
    root.addEventListener('focusout', () => queueMicrotask(updateFocusPause));
    document.addEventListener('visibilitychange', scheduleAutoPlay);
    reducedMotion.addEventListener('change', scheduleAutoPlay);

    showSlide(0, false, false);
    updatePlayback();
    scheduleAutoPlay();
  });
</script>
