---
import { company } from '../../data/company';
import { contactPolicy } from '../../data/contact';
import { getLocalePath } from '../../i18n/config';
import type { TermsDocumentContent } from '../../types/terms';
import LegalTableOfContents from '../legal/LegalTableOfContents.astro';

interface Props {
  content: TermsDocumentContent;
}

const { content } = Astro.props;
const privacyPath = getLocalePath(content.locale, 'privacy');
---

<div class="privacy-layout">
  <aside class="privacy-layout__aside">
    <LegalTableOfContents label={content.tableOfContentsLabel} sections={content.sections} variant="desktop" />
  </aside>

  <article class="privacy-document">
    {
      content.sections.map((section, index) => (
        <section id={section.id} class="privacy-section" aria-labelledby={`${section.id}-title`}>
          <div class="privacy-section__heading">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
          </div>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
          {section.links && (
            <ul class="privacy-section__links">
              {section.links.map((link) => {
                const external = /^https?:\/\//.test(link.href);
                return (
                  <li>
                    <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                      {link.label}
                      {external && <span class="screen-reader"> ({content.externalLinkLabel})</span>}
                      {external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    }

    <section class="privacy-contact-card" aria-labelledby="terms-contact-card-title">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="terms-contact-card-title">{content.contactCardTitle}</h2>
      <dl>
        <div>
          <dt>{content.contactLabels.name}</dt>
          <dd>{company.name}</dd>
        </div>
        <div>
          <dt>{content.contactLabels.website}</dt>
          <dd><a href="https://lvb.kr/">https://lvb.kr/</a></dd>
        </div>
        <div>
          <dt>{content.contactLabels.email}</dt>
          <dd><a href={`mailto:${contactPolicy.businessEmail}`}>{contactPolicy.businessEmail}</a></dd>
        </div>
        <div>
          <dt>{content.contactLabels.privacy}</dt>
          <dd><a href={privacyPath}>{content.privacyLabel}</a></dd>
        </div>
      </dl>
    </section>
  </article>
</div>
