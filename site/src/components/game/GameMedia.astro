---
import type { GameImage } from '../../types/game';

interface Props {
  image: GameImage | null;
  alt: string;
  loading?: 'eager' | 'lazy';
  fit?: 'cover' | 'contain';
  fallbackText?: string;
  className?: string;
}

const { image, alt, loading = 'lazy', fit = 'cover', fallbackText = 'Game image unavailable', className } = Astro.props;
---

<div class:list={['game-media', `game-media--${fit}`, className]}>
  {image ? (
    <img src={image.src} width={image.width} height={image.height} alt={alt} loading={loading} decoding="async" fetchpriority={loading === 'eager' ? 'high' : 'auto'} />
  ) : (
    <span class="game-media__fallback">{fallbackText}</span>
  )}
</div>
