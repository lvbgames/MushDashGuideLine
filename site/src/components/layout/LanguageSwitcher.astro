---
import { getLocalePath, localeLabels, locales, type Locale, type SiteRoute } from '../../i18n/config';

interface Props {
  locale: Locale;
  currentPath: string;
  route?: SiteRoute;
  label: string;
  className?: string;
}

const { locale, route = 'home', label, className } = Astro.props;
---

<nav class:list={['language-switcher', className]} aria-label={label}>
  {locales.map((target) => (
    <a href={getLocalePath(target, route)} aria-current={target === locale ? 'page' : undefined} lang={target}>{localeLabels[target]}</a>
  ))}
</nav>
