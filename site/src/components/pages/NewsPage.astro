---
import { games } from '../../data/games';
import { socialLinks } from '../../data/socialLinks';
import type { Locale } from '../../i18n/config';
import { getTranslation } from '../../i18n/translations';
import { getNewsPageItems, newsPageCount } from '../../utils/newsPagination';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/news.css';
import NewsItemCard from '../news/NewsItemCard.astro';
import NewsPagination from '../news/NewsPagination.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SocialLinks from '../social/SocialLinks.astro';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
  currentPage?: number;
}

const { locale, currentPage = 1 } = Astro.props;
const translation = getTranslation(locale);
const pageItems = getNewsPageItems(currentPage);
const routeParam = currentPage === 1 ? undefined : String(currentPage);
const pageNumber = String(currentPage);
const title = currentPage === 1
  ? translation.meta.newsTitle
  : translation.news.paginationTitle.replace('{page}', pageNumber);
const description = currentPage === 1
  ? translation.meta.newsDescription
  : translation.news.paginationDescription.replace('{page}', pageNumber);

if (pageItems.length === 0) {
  throw new Error('News requires at least one verified item.');
}

const mushHero = games.find((game) => game.slug === 'mushhero');
const ogImage = mushHero?.screenshots[0]?.src ?? mushHero?.heroImage?.src;

if (!ogImage) {
  throw new Error('News requires a verified Open Graph image.');
}
---

<BaseLayout
  locale={locale}
  route="news"
  routeParam={routeParam}
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={translation.gamesPage.gameImageAlts.mushhero}
>
  <SiteHeader locale={locale} currentPath={Astro.url.pathname} route="news" routeParam={routeParam} translation={translation} />
  <main class="news-page" data-motion-page>
    <section class="news-hero" aria-labelledby="news-title">
      <Container>
        <p class="eyebrow">{translation.news.heroEyebrow}</p>
        <h1 id="news-title">{translation.news.heroTitle}</h1>
        <p>{translation.news.heroDescription}</p>
      </Container>
    </section>

    <section class="news-archive page-section" aria-labelledby="news-archive-title">
      <Container>
        <div class="news-archive__heading">
          <p class="eyebrow">{translation.news.allEyebrow}</p>
          <h2 id="news-archive-title">{translation.news.allTitle}</h2>
        </div>
        <div class="news-list">
          {
            pageItems.map((item) => (
              <NewsItemCard
                item={item}
                locale={locale}
                translation={translation}
                titleId={`news-${item.slug}`}
              />
            ))
          }
        </div>
        <NewsPagination locale={locale} currentPage={currentPage} totalPages={newsPageCount} translation={translation} />
      </Container>
    </section>

    <section class="news-follow page-section" aria-labelledby="news-follow-title">
      <Container className="news-follow__inner">
        <div class="news-follow__intro">
          <p class="eyebrow">{translation.news.followEyebrow}</p>
          <h2 id="news-follow-title">{translation.news.followTitle}</h2>
          <p>{translation.news.followDescription}</p>
        </div>
        <SocialLinks
          links={socialLinks}
          label={translation.nav.follow}
          externalLabel={translation.common.opensNewTab}
          variant="list"
          linkCopy={translation.home.followLinks}
        />
      </Container>
    </section>
  </main>
  <SiteFooter locale={locale} route="news" translation={translation} />
</BaseLayout>
