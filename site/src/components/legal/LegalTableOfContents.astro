---
interface LegalSectionLink {
  id: string;
  title: string;
}

interface Props {
  label: string;
  sections: readonly LegalSectionLink[];
  variant: 'desktop' | 'mobile';
}

const { label, sections, variant } = Astro.props;
---

{
  variant === 'desktop' ? (
    <nav class="privacy-toc privacy-toc--desktop" aria-label={label}>
      <p>{label}</p>
      <ol>
        {sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`}>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {section.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="privacy-toc privacy-toc--mobile">
      <summary>{label}</summary>
      <nav aria-label={label}>
        <ol>
          {sections.map((section, index) => (
            <li>
              <a href={`#${section.id}`}>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
