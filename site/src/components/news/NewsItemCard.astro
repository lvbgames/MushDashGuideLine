---
import { getLocalePath, type Locale } from '../../i18n/config';
import type { Translation } from '../../i18n/translations/en';
import type { NewsItem } from '../../types/news';
import ExternalLink from '../ui/ExternalLink.astro';

interface Props {
  item: NewsItem;
  locale: Locale;
  translation: Translation;
  titleId?: string;
}

const { item, locale, translation, titleId } = Astro.props;
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  ko: 'ko-KR',
  ja: 'ja-JP',
  'zh-cn': 'zh-CN'
};
const formattedDate = new Intl.DateTimeFormat(dateLocale[locale], {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(new Date(`${item.publishedAt}T00:00:00Z`));
const internalHref = item.type === 'internal' ? getLocalePath(locale, 'news-article', item.slug) : null;
---

<article class="news-card" aria-labelledby={titleId}>
  <div class="news-card__meta">
    <span class="news-card__kind">{translation.news.kindLabels[item.kind]}</span>
    <span>{item.type === 'internal' ? item.author : item.publisher}</span>
    {item.type === 'external' && item.author && <span>{item.author}</span>}
    <time datetime={item.publishedAt}>{formattedDate}</time>
  </div>
  <h3 id={titleId}>{item.localizedTitle[locale]}</h3>
  <p>{item.localizedSummary[locale]}</p>
  {item.type === 'external' ? (
    <ExternalLink href={item.sourceUrl} externalLabel={translation.common.opensNewTab}>
      <span class="news-card__source">{translation.news.sourceCta}</span>
    </ExternalLink>
  ) : (
    <a class="news-card__internal-link" href={internalHref ?? undefined}>
      <span class="news-card__internal-cta">{translation.news.internalCta}</span>
    </a>
  )}
</article>
