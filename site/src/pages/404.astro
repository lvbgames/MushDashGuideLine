---
import Container from '../components/ui/Container.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import '../styles/global.css';
import '../styles/not-found.css';

const site = new URL('https://lvb.kr');
const socialImage = new URL('/brand/lvb-og.png', site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f0d0c" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="The requested Lv.B page could not be found. Return home or explore our games." />
    <link rel="icon" type="image/png" sizes="128x128" href="/brand/lvb-symbol-128.png" />
    <link rel="apple-touch-icon" href="/brand/lvb-symbol-128.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lv.B" />
    <meta property="og:title" content="Page not found — Lv.B" />
    <meta property="og:description" content="The requested Lv.B page could not be found. Return home or explore our games." />
    <meta property="og:image" content={socialImage} />
    <title>Page not found — Lv.B</title>
  </head>
  <body class="not-found-body">
    <header class="not-found-header">
      <Container className="not-found-header__inner">
        <a class="site-brand not-found-brand" href="/" aria-label="Lv.B home">
          <img class="site-brand__icon" src="/brand/lvb-symbol.png" width="794" height="769" alt="" loading="eager" decoding="async" />
          <span class="site-brand__wordmark" aria-hidden="true">Lv.B</span>
        </a>
      </Container>
    </header>

    <main class="not-found-page">
      <Container className="not-found-page__inner">
        <div class="not-found-page__mark" aria-hidden="true">
          <img src="/brand/lvb-symbol.png" width="794" height="769" alt="" loading="eager" decoding="async" />
        </div>
        <div class="not-found-page__copy">
          <p class="eyebrow">404</p>
          <h1>Page not found.</h1>
          <p>The page may have moved or the address may be incorrect. You can return home or continue exploring our games.</p>
          <nav class="not-found-page__actions" aria-label="Page not found actions">
            <ButtonLink href="/">Go to Home</ButtonLink>
            <ButtonLink href="/games/" variant="quiet">Explore Games</ButtonLink>
          </nav>
        </div>
      </Container>
    </main>

    <footer class="not-found-footer">
      <Container className="not-found-footer__inner">
        <p>Choose a homepage language</p>
        <nav aria-label="Homepage languages">
          <a href="/" lang="en">English</a>
          <a href="/ko/" lang="ko">한국어</a>
          <a href="/ja/" lang="ja">日本語</a>
          <a href="/zh-cn/" lang="zh-cn">简体中文</a>
        </nav>
      </Container>
    </footer>
  </body>
</html>
